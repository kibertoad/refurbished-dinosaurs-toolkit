{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/dist/**",
    "packages/standard-checker/test/valid/**"
  ],
  "overrides": [
    {
      "files": [
        "packages/*/src/**/*.ts",
        "packages/*/bin/**/*.ts",
        "tools/**/*.ts"
      ],
      "excludeFiles": [
        "**/*.test.ts"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 500,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    }
  ]
}
