{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kibertoad/toad-discovery-center/schemas/asset-manifest.schema.json",
  "title": "Original asset source manifest",
  "type": "object",
  "required": ["gameId", "sourceEdition", "files"],
  "properties": {
    "gameId": { "type": "string", "minLength": 1 },
    "sourceEdition": { "type": "string", "minLength": 1 },
    "sourceKind": { "enum": ["directory", "iso9660", "cue-bin", "installshield-cabinet"], "default": "directory" },
    "files": {
      "type": "array",
      "$comment": "At least one file must be required, or the manifest would match any copy.",
      "contains": {
        "not": { "required": ["required"], "properties": { "required": { "const": false } } }
      },
      "items": {
        "type": "object",
        "required": ["path", "size"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "xxh3": { "type": ["string", "null"], "pattern": "^[0-9a-f]{32}$" },
          "required": { "type": "boolean", "default": true }
        },
        "additionalProperties": false
      }
    },
    "audioTracks": {
      "type": "array",
      "$comment": "CD audio tracks identified across drive read offsets. Samples are 16-bit stereo pairs, 588 to a sector. Two rules the schema cannot express: each track appears once, and the anchor lies at least toleranceSamples inside both ends of the track.",
      "items": {
        "type": "object",
        "required": ["track", "samples", "toleranceSamples", "anchorOffset", "anchorSamples", "anchorXxh3", "centralXxh3"],
        "properties": {
          "track": { "type": "integer", "minimum": 2, "maximum": 99 },
          "samples": { "type": "integer", "minimum": 1 },
          "toleranceSamples": { "type": "integer", "minimum": 0, "maximum": 5880 },
          "anchorOffset": { "type": "integer", "minimum": 0 },
          "anchorSamples": { "type": "integer", "minimum": 1, "maximum": 44100 },
          "anchorXxh3": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "centralXxh3": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "if": {
    "not": { "required": ["sourceKind"], "properties": { "sourceKind": { "const": "cue-bin" } } }
  },
  "then": {
    "properties": { "audioTracks": { "maxItems": 0 } }
  },
  "additionalProperties": false
}
