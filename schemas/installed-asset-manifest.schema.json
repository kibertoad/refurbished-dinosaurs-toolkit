{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kibertoad/toad-discovery-center/schemas/installed-asset-manifest.schema.json",
  "title": "Installed original-content manifest",
  "type": "object",
  "required": ["formatVersion", "product", "sourceEdition", "sourceFingerprintSha256", "extractedAtUtc", "files", "extractorVersion"],
  "properties": {
    "formatVersion": { "type": "integer", "minimum": 1 },
    "product": { "type": "string", "minLength": 1 },
    "sourceEdition": { "type": "string", "minLength": 1 },
    "sourceFingerprintSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "extractedAtUtc": { "type": "string", "format": "date-time" },
    "extractorVersion": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256", "sourcePath", "mediaType"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "sourcePath": { "type": "string", "minLength": 1 },
          "mediaType": { "type": "string", "minLength": 1 },
          "conversion": {
            "type": ["object", "null"],
            "properties": {
              "method": { "type": "string", "minLength": 1 },
              "width": { "type": ["integer", "null"], "minimum": 1 },
              "height": { "type": ["integer", "null"], "minimum": 1 },
              "bitsPerPixel": { "type": ["integer", "null"], "minimum": 1 },
              "pixelFormat": { "type": ["string", "null"] }
            },
            "required": ["method"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
