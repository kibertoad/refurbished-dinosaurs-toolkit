<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Toad.Discovery.Core</PackageId>
    <Version>0.1.0</Version>
    <Authors>kibertoad</Authors>
    <Description>Reusable clean-room game restoration primitives.</Description>
    <PackageTags>monogame;game-restoration;clean-room;asset-extraction</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/kibertoad/toad-discovery-center</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
