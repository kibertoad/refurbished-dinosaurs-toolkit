<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>RefurbishedDinosaurs.LegacyFormats</PackageId>
    <Description>Bounded decoders for file formats commonly found in legacy games.</Description>
    <PackageTags>game-restoration;pcx;bmp;rle8;iso9660;installshield</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RefurbishedDinosaurs.Core/RefurbishedDinosaurs.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The tests reach AssetVerifier.IdentifyAsync's opener overload to count reads of a source. -->
    <InternalsVisibleTo Include="RefurbishedDinosaurs.Core.Tests" />
  </ItemGroup>
</Project>
