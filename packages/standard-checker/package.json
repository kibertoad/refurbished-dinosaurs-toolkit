{
  "name": "@scientific-method/standard-checker",
  "version": "2.5.0",
  "description": "Checks a restoration's spec/, parity/ and deviations/ against version 1 of the dinorefurb documentation standard.",
  "type": "module",
  "license": "MIT",
  "author": "kibertoad",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kibertoad/refurbished-dinosaurs-toolkit.git",
    "directory": "packages/standard-checker"
  },
  "bin": {
    "standard-checker": "dist/standard-checker.js",
    "standard-coverage": "dist/coverage.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "test": "node --test \"test/*.test.ts\""
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
